    "## EXTRACT FRAMES FROM VIDEO & WRITE YOLO LABELS\n",
    "#  For each matched XML/video pair, this block:\n",
    "#    a) calls parse_moving_frames() to get the qualifying frame indices + boxes\n",
    "#    b) opens the video and seeks to each index using cv2.CAP_PROP_POS_FRAMES\n",
    "#    c) saves the JPEG frame to FRAMES_DIR\n",
    "#    d) filters boxes to moving-only, writes the YOLO .txt label to LABELS_DIR\n",
    "#    e) appends the moving-only boxes to `annotations` for use \n",
    "\n",
    "#  Why cv2.CAP_PROP_POS_FRAMES instead of sequential read?\n",
    "#  OpenCV's seek jumps directly to a frame timestamp without decoding every frame in between. \n",
    "#  For a 30fps video where only ~5% of frames qualify, this is dramatically faster and avoids writing thousands of unwanted JPEGs.\n",
    "\n",
    "#  Why drop stationary boxes at label-writing stage? \n",
    "#  parse_moving_frames() returns ALL boxes in qualifying frames, tagged with \"is_moving.\"\n",
    "#  We keep them all through by far, because we need them to determine which \"frames\" qualify. \n",
    "#  But at label-writing stage, we filter to is_mov==True only\n",
    "#  This means:\n",
    "#   - The JPEG (full frame) is saved — the scene including stationary balls\n",
    "#   - The .txt label file contains ONLY moving ball coordinates\n",
    "#   - Stationary balls in that frame become unlabeled background\n",
    "#   - YOLO learns: \"a moving ball is a positive detection; everything else, including a stationary ball, is background — ignore it\"\n",
    "#  - mAP (accuracy measure) therefore measures purely moving-ball detection performance\n",
    "\n",
    "#  Accordingly, `annotations` is also filtered to moving boxes only. \n",
    "#  YOLO label format (one line per box):\n",
    "#    class_id  cx  cy  w  h   (all values normalised 0–1 relative to image size)\n",
    "#    class_id is always 0 (\"baseball\") — single class, no moving/stationary split\n",
    "\n",
    "def to_yolo(xtl, ytl, xbr, ybr, W, H):\n",
    "    ## Convert pixel coords to YOLO normalised format.\n",
    "    ## Clamp to [0,1] guards against boxes that slightly exceed image boundaries\n",
    "    cx = max(0., min(1., (xtl + xbr) / 2 / W))\n",
    "    cy = max(0., min(1., (ytl + ybr) / 2 / H))\n",
    "    w  = max(0., min(1., (xbr - xtl)     / W))\n",
    "    h  = max(0., min(1., (ybr - ytl)     / H))\n",
    "    return f\"0 {cx:.6f} {cy:.6f} {w:.6f} {h:.6f}\"\n",
    "\n",
    "annotations = []  # [(jpg_path_str, [(xtl, ytl, xbr, ybr, W, H), ...])  — moving boxes only]\n",
    "\n",
    "## LOAD EXISTING FRAMES (replaces video extraction loop)\n",
    "#  Frames and labels already extracted — read directly from moving_frames / moving_labels.\n",
    "#  Each .txt label file contains one line per moving ball in that frame:\n",
    "#    class_id  cx  cy  w  h   (all normalised 0–1)\n",
    "#  We reconstruct the `annotations` list in the same format the rest of the\n",
    "#  script expects:  [(jpg_path_str, [(xtl, ytl, xbr, ybr, W, H), ...]), ...]\n",
    "#  Since we only need (W, H) for to_yolo() calls later and the coords are\n",
    "#  already normalised in the .txt files, we read image dims once via cv2\n",
    "#  and back-convert to pixel coords so the format stays consistent.\n",
    "\n",
    "annotations = []\n",
    "skipped     = 0\n",
    "\n",
    "for jpg_path in sorted(FRAMES_DIR.glob(\"*.jpg\")):\n",
    "    lbl_path = LABELS_DIR / (jpg_path.stem + \".txt\")\n",
    "    if not lbl_path.exists():\n",
    "        skipped += 1\n",
    "        continue\n",
    "\n",
    "    img = cv2.imread(str(jpg_path))\n",
    "    if img is None:\n",
    "        skipped += 1\n",
    "        continue\n",
    "    H, W = img.shape[:2]\n",
    "\n",
    "    boxes = []\n",
    "    with open(lbl_path) as f:\n",
    "        for line in f:\n",
    "            parts = line.strip().split()\n",
    "            if len(parts) != 5:\n",
    "                continue\n",
    "            # parts: class_id cx cy w h  (normalised)\n",
    "            cx, cy, bw, bh = map(float, parts[1:])\n",
    "            # back-convert to pixel coords\n",
    "            xtl = (cx - bw / 2) * W\n",
    "            ytl = (cy - bh / 2) * H\n",
    "            xbr = (cx + bw / 2) * W\n",
    "            ybr = (cy + bh / 2) * H\n",
    "            boxes.append((xtl, ytl, xbr, ybr, W, H))\n",
    "\n",
    "    if boxes:\n",
    "        annotations.append((str(jpg_path), boxes))\n",
    "\n",
    "print(f\"Loaded  : {len(annotations)} annotated frames\")\n",
    "print(f\"Skipped : {skipped} (no label or unreadable image)\")"
   ]
  },
