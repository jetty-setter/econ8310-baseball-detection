   "source": [
    "## DEDUPLICATE, SHUFFLE, SPLIT\n",
    "#  Deduplication: guards against any frame path appearing twice. \n",
    "#  This can happen in rare edge cases if two XML tracks annotate the same frame independently.\n",
    "#  Using a seen-set keeps only the first occurrence.\n",
    "#  Shuffle with fixed seed: RANDOM_SEED=42 ensures the exact same train/val split is produced on every re-run of this script. \n",
    "#  Reproducibility matters here because we want to be able to re-run individual learning curve fractions without accidentally getting a different val set.\n",
    "#  80/20 split: 80% goes to trn_set (the pool the LC sweep samples from), 20% goes to val_set. \n",
    "#  The val set is locked here and NEVER touched again during the sweep — it is identical across all 5 training runs. \n",
    "#  This is the key property that makes the mAP values at different fractions directly comparable to each other. \n",
    "#  If the val set changed between runs, you couldn't tell whether a mAP improvement came from more training data or from an easier val set.\n",
    "seen, unique = set(), []\n",
    "for p, b in annotations:\n",
    "    if p not in seen:\n",
    "        seen.add(p); unique.append((p, b))\n",
    "\n",
    "random.seed(RANDOM_SEED)\n",
    "random.shuffle(unique)\n",
    "\n",
    "n_val   = max(1, int(len(unique) * VAL_SPLIT))\n",
    "val_set = unique[:n_val]\n",
    "trn_set = unique[n_val:]\n",
    "print(f\"Split → train: {len(trn_set)}  val: {len(val_set)}\")"
   ]
