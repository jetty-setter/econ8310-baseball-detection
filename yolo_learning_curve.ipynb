   "source": [
    "## BUILDING YOLO AND TRAINING \n",
    "#  Learning Curve Experiment: For each fraction in TRAIN_FRACTIONS we answer:\n",
    "#  \"If the model had only seen X% of the available training data, how well would it detect moving baseballs?\"\n",
    "\n",
    "#  For each fraction the loop does five things:\n",
    "#   1. SAMPLE the subset\n",
    "#      n = fraction × len(trn_set) frames are sampled from trn_set.\n",
    "#      Each fraction uses a distinct seed (RANDOM_SEED + frac*1000) \n",
    "#      So the subsets are not simply nested prefixes of each other. \n",
    "#      (e.g., the 10% and 30% subsets share some frames but aren't strictly one inside the other) —\n",
    "#      This reduces the risk that one particular cluster of easy frames dominates all small-fraction results.\n",
    "\n",
    "#   2. WRITE a self-contained dataset folder\n",
    "#      lc_experiment/pct_010/images/train   ← subset images\n",
    "#      lc_experiment/pct_010/images/val     ← full val set (same every run)\n",
    "#      lc_experiment/pct_010/labels/train   ← moving-ball labels only\n",
    "#      lc_experiment/pct_010/labels/val     ← moving-ball labels only\n",
    "#      lc_experiment/pct_010/dataset.yaml   ← YOLO config for this fraction\n",
    "#      Each fraction is fully self-contained so YOLO never touches another fraction's files. \n",
    "#      This also means you can re-run a single fraction independently without re-running the whole sweep.\n",
    "\n",
    "#   3. WRITE dataset.yaml\n",
    "#      nc=1, names=[\"baseball\"]. Single class  \n",
    "#      YOLO only needs to know \"there is a ball here\"\n",
    "\n",
    "#   4. TRAIN a fresh model\n",
    "#      Always starts from yolov8n.pt pretrained weights. \n",
    "#      All hyperparameters are identical across runs — the ONLY variable is n (training set size).\n",
    "#      Augmentations: \n",
    "#       colour jitter (hsv), \n",
    "#       horizontal flip, \n",
    "#       mosaic (combine 4 images into one training sample — effective for small datasets),\n",
    "#       rotation, \n",
    "#       translation, \n",
    "#       scale. \n",
    "#      These are kept constant so differences in mAP are attributable to data volume, not augmentation differences.\n",
    "\n",
    "#   5. EVALUATE best.pt on the fixed val set\n",
    "#      YOLO saves best.pt = the checkpoint with the best validation loss during training (not necessarily the last epoch).\n",
    "#      We load that and run .val() on the fixed val set. \n",
    "#      Four metrics are logged:\n",
    "#        mAP@0.5      — A detection counts as correct \n",
    "#                       if the predicted box overlaps the ground-truth box by ≥50% (IoU ≥ 0.5). \n",
    "#                       This is the standard COCO detection metric.\n",
    "#        mAP@0.5-0.95 — Stricter. Averaged over IoU thresholds 0.5, 0.55, ..., 0.95. \n",
    "#                       Rewards models that localise the ball precisely, not just roughly.\n",
    "#        Precision    — of all boxes the model predicted as \"baseball\",\n",
    "#                       \"what fraction were correct?\"\" \n",
    "#                       Low precision = too many false positives (model fires on background / stationary balls).\n",
    "#        Recall       — of all actual moving balls in the val set, \n",
    "#                       \"what fraction did the model find?\" \n",
    "#                       Low recall = missed detections.\n",
    "#      What you can conclude from the output:\n",
    "#       • If mAP flattens between 50% and 100% → you have enough data; more annotation won't meaningfully improve the model.\n",
    "#       • If mAP is still climbing steeply at 100% → the model is data-hungry; annotating more footage would help.\n",
    "#       • Precision vs Recall shape tells you the character of remaining errors.\n",
    "\n",
    "lc_dir  = Path(OUTPUT_DIR) / \"lc_experiment\"  # per-fraction dataset folders\n",
    "lc_runs = Path(OUTPUT_DIR) / \"lc_runs\"        # YOLO training outputs (weights, plots)\n",
    "results = []\n",
    "print(\"\\n\" + \"=\"*60 + \"\\nLEARNING CURVE SWEEP\\n\" + \"=\"*60)\n",
    "for frac in TRAIN_FRACTIONS:\n",
    "    n      = max(1, int(len(trn_set) * frac))\n",
    "    tag    = f\"pct_{int(frac*100):03d}\"                           # e.g. \"pct_010\"\n",
    "    subset = random.Random(RANDOM_SEED + int(frac*1000)).sample(trn_set, n)\n",
    "    print(f\"\\n[{tag}] {n} train frames\")\n",
    "\n",
    "    base = lc_dir / tag  # Write images + labels into lc_experiment/pct_XXX/images|labels/train|val\n",
    "    for split, data in [(\"train\", subset), (\"val\", val_set)]:\n",
    "        img_out = base / \"images\" / split;  img_out.mkdir(parents=True, exist_ok=True)\n",
    "        lbl_out = base / \"labels\" / split;  lbl_out.mkdir(parents=True, exist_ok=True)\n",
    "        for p, boxes in data:\n",
    "            p = Path(p)\n",
    "            shutil.copy2(p, img_out / p.name)\n",
    "            with open(lbl_out / f\"{p.stem}.txt\", \"w\") as f:\n",
    "                f.writelines(to_yolo(xtl, ytl, xbr, ybr, W, H) + \"\\n\" # boxes are (xtl, ytl, xbr, ybr, W, H) — moving only, matches LABELS_DIR\n",
    "                             for (xtl, ytl, xbr, ybr, W, H) in boxes)\n",
    "\n",
    "    yaml_path = base / \"dataset.yaml\" # dataset.yaml — nc=1, single class (moving baseball only)\n",
    "    with open(yaml_path, \"w\") as f:\n",
    "        yaml.dump({\"path\" : str(base).replace(\"\\\\\", \"/\"),\n",
    "                   \"train\": \"images/train\",\n",
    "                   \"val\"  : \"images/val\",\n",
    "                   \"nc\"   : 1,\n",
    "                   \"names\": [\"baseball\"]}, f, default_flow_style=False)\n",
    "\n",
    "    YOLO(MODEL_SIZE).train(  # Train fresh model — identical hyperparams every run, only n changes\n",
    "        data      = str(yaml_path),\n",
    "        epochs    = EPOCHS,       # Now set to 10\n",
    "        imgsz     = IMG_SIZE,\n",
    "        batch     = 16,           # Too low batch size will make learning slower\n",
    "        device    = \"mps\",        # ← change to \"cuda\" (or 0) for GPU\n",
    "        project   = str(lc_runs),\n",
    "        name      = tag,\n",
    "        patience  = 10,           #  Raise patience only if you raise EPOCHS substantially\n",
    "        hsv_h=0.015, hsv_s=0.7, hsv_v=0.4,      # colour augmentation\n",
    "        fliplr=0.5,  mosaic=1.0,                # flip + 4-image mosaic mix\n",
    "        degrees=10.0, translate=0.1, scale=0.5, # geometric augmentation\n",
    "        save=True, plots=True, verbose=False,\n",
    "    )\n",
    "\n",
    "    best = Path(sorted(glob.glob(str(lc_runs / f\"{tag}*\")))[-1]) / \"weights\" / \"best.pt\"     # Load best checkpoint and evaluate on the fixed val set\n",
    "    m    = YOLO(str(best)).val(data=str(yaml_path), imgsz=IMG_SIZE, device=\"cpu\")\n",
    "    row = {\"fraction\"  : frac,\n",
    "           \"n_train\"   : n,\n",
    "           \"map50\"     : round(m.box.map50, 4),  # IoU ≥ 0.5\n",
    "           \"map50_95\"  : round(m.box.map,   4),  # IoU 0.5:0.05:0.95 average\n",
    "           \"precision\" : round(m.box.mp,    4),  # TP / (TP + FP)\n",
    "           \"recall\"    : round(m.box.mr,    4)}  # TP / (TP + FN)\n",
    "    results.append(row)\n",
    "    print(f\"  mAP@0.5={row['map50']}  mAP@0.5-0.95={row['map50_95']}  \"\n",
    "          f\"P={row['precision']}  R={row['recall']}\")"
   ]
  },
