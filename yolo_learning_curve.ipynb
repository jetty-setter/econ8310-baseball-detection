   "source": [
    "## SAVE RESULTS & PLOT\n",
    "#  All five rows are saved to learning_curve_results.csv — one row per fraction.\n",
    "#  The plot has two panels:\n",
    "#    LEFT — mAP@0.5 and mAP@0.5-0.95\n",
    "#      The primary answer to the research question. \n",
    "#      X-axis is actual frame counts (not percentages) \n",
    "#      So the spacing reflects real data volume — equal percentage steps don't mean equal information gain. \n",
    "#      Percentage labels are annotated above each point so you can read the plot without looking at the CSV. \n",
    "#      *If the curve flattens → enough data. \n",
    "#      *If it's still climbing → needs more data.\n",
    "#    RIGHT — Precision & Recall\n",
    "#      Tells you the character of the remaining errors at each data size.\n",
    "#      Low precision → model fires on things that aren't moving balls (false positives — possibly stationary balls or background clutter).\n",
    "#      Low recall → model misses real moving balls (false negatives — possibly fast motion blur or small ball size at distance).\n",
    "\n",
    "df       = pd.DataFrame(results)\n",
    "csv_path = Path(OUTPUT_DIR) / \"learning_curve_results.csv\"\n",
    "df.to_csv(csv_path, index=False)\n",
    "print(f\"\\n{df.to_string(index=False)}\\nSaved → {csv_path}\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
    "fig.suptitle(\"Learning curve — YOLOv8n moving baseball detection\", fontsize=12)\n",
    "x = df[\"n_train\"]\n",
    "\n",
    "# Left panel: mAP\n",
    "axes[0].plot(x, df[\"map50\"],    \"o-\",  color=\"#3266ad\", label=\"mAP@0.5\")\n",
    "axes[0].plot(x, df[\"map50_95\"], \"s--\", color=\"#73726c\", label=\"mAP@0.5-0.95\")\n",
    "for _, r in df.iterrows():\n",
    "    axes[0].annotate(f\"{int(r.fraction*100)}%\", (r.n_train, r.map50),\n",
    "                     textcoords=\"offset points\", xytext=(0, 6), fontsize=8, ha=\"center\")\n",
    "axes[0].set(title=\"mAP\", xlabel=\"Training frames\", ylabel=\"Score\", ylim=(0, 1))\n",
    "axes[0].legend(fontsize=9); axes[0].grid(alpha=0.3)\n",
    "\n",
    "# Right panel: Precision & Recall\n",
    "axes[1].plot(x, df[\"precision\"], \"o-\",  color=\"#1D9E75\", label=\"Precision\")\n",
    "axes[1].plot(x, df[\"recall\"],    \"s--\", color=\"#D85A30\", label=\"Recall\")\n",
    "axes[1].set(title=\"Precision & Recall\", xlabel=\"Training frames\", ylabel=\"Score\", ylim=(0, 1))\n",
    "axes[1].legend(fontsize=9); axes[1].grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plot_path = Path(OUTPUT_DIR) / \"learning_curve.png\"\n",
    "plt.savefig(plot_path, dpi=150, bbox_inches=\"tight\")\n",
    "plt.close()\n",
    "\n",
    "print(f\"Plot saved → {plot_path}\")\n",
    "print(\"\\n\" + \"=\"*60)\n",
