   "source": [
    "## PARSE XML & FIND QUALIFYING FRAMES\n",
    "#  For each XML, this function reads every annotated bounding box across all tracks \n",
    "#  And decides which frames qualify for extraction.\n",
    "#  Three discard rules are applied immediately at the box level:\n",
    "#  (1) outside=1    → CVAT marks \"outside\" when the ball has left the frame but continues between keyframes. \n",
    "#                    The box exists in the XML but the ball isn't actually visible — skip it.\n",
    "#  (2) parse error  → Malformed coordinate attribute, annotation error — skip.\n",
    "#  (3) degenerate   → xbr≤xtl or ybr≤ytl means zero or negative area. \n",
    "#                    Happens when an annotator accidentally placed corners in the wrong order — skip.\n",
    "#  A frame is added to moving_set (and therefore qualifies), if AT LEAST ONE of its boxes has moving=true. \n",
    "#  Frames where every box is stationary never enter moving_set and are completely ignored; This will save you memory & storage\n",
    "#  For every valid box the \"is_moving\" flag is read from the CVAT attribute \n",
    "#  Stored as the 5th element of the tuple: (xtl, ytl, xbr, ybr, is_moving).\n",
    "#  Returns: { frame_idx: [(xtl, ytl, xbr, ybr, is_moving), ...] } only for qualifying frames.\n",
    "def parse_moving_frames(xml_path):\n",
    "    try:\n",
    "        root = ET.parse(xml_path).getroot()\n",
    "    except ET.ParseError as e:\n",
    "        print(f\"  WARN: XML parse error {xml_path}: {e}\"); return {}\n",
    "    frame_boxes, moving_set = {}, set()\n",
    "    for track in root.findall(\"track\"):\n",
    "        for box in track.findall(\"box\"):\n",
    "            if int(box.attrib.get(\"outside\", 0)) == 1:\n",
    "                continue                                  # not visible, skip\n",
    "            idx = int(box.attrib[\"frame\"])\n",
    "            try:\n",
    "                xtl, ytl = float(box.attrib[\"xtl\"]), float(box.attrib[\"ytl\"])\n",
    "                xbr, ybr = float(box.attrib[\"xbr\"]), float(box.attrib[\"ybr\"])\n",
    "            except (KeyError, ValueError):\n",
    "                continue\n",
    "            if xbr <= xtl or ybr <= ytl:\n",
    "                continue                                  # degenerate box, skip\n",
    "            attr      = box.find(\"attribute[@name='moving']\")\n",
    "            is_moving = (attr is not None and attr.text\n",
    "                         and attr.text.strip().lower() == \"true\")\n",
    "            frame_boxes.setdefault(idx, []).append((xtl, ytl, xbr, ybr, is_moving))\n",
    "            if is_moving:\n",
    "                moving_set.add(idx)                      # frame qualifies\n",
    "    return {idx: frame_boxes[idx] for idx in moving_set}"
   ]
  },
